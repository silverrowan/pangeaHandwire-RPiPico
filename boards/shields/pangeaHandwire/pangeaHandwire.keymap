#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
//#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "default";
//            |   0   |   1   |   2   |   3   |   4   |   5   |
//            |  y  |   Q   |   W   |   E   |   R   |   T   |
//            |  h  |   A   |   S   |   D   |   F   |   G   |
//            | n|   Z   |   X   |   C   |   V   |   B   |
//                        |   u   |   j   |   m   |   i   |   k   |
            bindings = <
&kp 0 &kp N1 &kp N2   &kp N3   &kp N4    &kp N5                           
&kp Y &kp Q  &kp W    &kp E    &kp R     &kp T
&kp H   &kp A  &kp S    &kp D    &kp F     &kp G                            
&kp N &kp Z  &kp X    &kp C    &kp V     &kp B
&kp U &kp J &kp M &kp I  &kp K
            >;
        };
    };
};